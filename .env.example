# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
EXPO_PUBLIC_BACKEND_API_URL=https://api.metus.vn/api
EXPO_PUBLIC_APP_URL=https://metus.vn

# OAuth Web client ID của Firebase project (đăng nhập Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Web API key của Firebase project (đổi Google idToken → Firebase idToken)
EXPO_PUBLIC_FIREBASE_API_KEY=

# OAuth iOS client ID (CLIENT_ID trong GoogleService-Info.plist) — chỉ cần khi build iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
