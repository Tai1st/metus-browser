{
  "expo": {
    "name": "Metus",
    "slug": "metus-browser",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metus",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.metus.browser",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06100A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.metus.browser",
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06100A"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.420333529909-a7ggckpu5r8k3l1qh8jjul0sck17kd9u"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Metus cần truy cập thư viện ảnh để bạn chọn ảnh/video đăng bài.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.metus.** { *; }\n-keep class okhttp3.** { *; }\n-keep class okio.** { *; }\n-dontwarn okhttp3.**\n-dontwarn okio.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
